<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════
     Family Admin v3.0 — Themes
     Complete Material Design 3 theme system
     ═══════════════════════════════════════════════════════════════
     Includes:
       • Base Theme (DayNight)
       • Splash Theme
       • Component Themes (Toolbar, Dialog, BottomSheet, etc.)
       • Light & Dark variants
     ═══════════════════════════════════════════════════════════════
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 1: BASE THEME (DayNight)
         ═══════════════════════════════════════════════════════════ -->
    <style name="Theme.FamilyAdmin" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ═══ Primary Colors ═══ -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryInverse">@color/primary_light</item>

        <!-- ═══ Secondary Colors ═══ -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- ═══ Tertiary Colors ═══ -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- ═══ Error Colors ═══ -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/white</item>

        <!-- ═══ Background & Surface ═══ -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- ═══ Status Bar ═══ -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- ═══ Window ═══ -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- ═══ Typography ═══ -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- ═══ Shapes ═══ -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FamilyAdmin.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FamilyAdmin.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.FamilyAdmin.LargeComponent</item>

        <!-- ═══ Material Components ═══ -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FamilyAdmin.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.FamilyAdmin.BottomSheetDialog</item>
        <item name="toolbarStyle">@style/Widget.FamilyAdmin.Toolbar</item>
        <item name="appBarLayoutStyle">@style/Widget.FamilyAdmin.AppBarLayout</item>
        <item name="materialButtonStyle">@style/Widget.FamilyAdmin.Button</item>
        <item name="textInputStyle">@style/Widget.FamilyAdmin.TextInputLayout</item>
        <item name="cardViewStyle">@style/Widget.FamilyAdmin.CardView</item>
        <item name="chipStyle">@style/Widget.FamilyAdmin.Chip</item>

        <!-- ═══ Animation ═══ -->
        <item name="android:windowAnimationStyle">@style/Animation.FamilyAdmin.Activity</item>

    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 2: SPLASH THEME
         ═══════════════════════════════════════════════════════════ -->
    <style name="Theme.FamilyAdmin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.FamilyAdmin</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 3: SHAPE APPEARANCES
         ═══════════════════════════════════════════════════════════ -->
    <style name="ShapeAppearance.FamilyAdmin.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.FamilyAdmin.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.FamilyAdmin.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 4: TOOLBAR
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white_50</item>
        <item name="android:elevation">4dp</item>
        <item name="android:theme">@style/ThemeOverlay.FamilyAdmin.Toolbar</item>
    </style>

    <style name="ThemeOverlay.FamilyAdmin.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Widget.FamilyAdmin.AppBarLayout" parent="Widget.MaterialComponents.AppBarLayout.Primary">
        <item name="android:background">@color/primary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 5: BUTTONS
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.FamilyAdmin.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <style name="Widget.FamilyAdmin.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.FamilyAdmin.Button.Danger" parent="Widget.FamilyAdmin.Button">
        <item name="backgroundTint">@color/button_danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.FamilyAdmin.Button.Success" parent="Widget.FamilyAdmin.Button">
        <item name="backgroundTint">@color/button_success</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.FamilyAdmin.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/white</item>
        <item name="elevation">6dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 6: CARDS
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FamilyAdmin.CardView.Elevated" parent="Widget.FamilyAdmin.CardView">
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.FamilyAdmin.CardView.Outlined" parent="Widget.FamilyAdmin.CardView">
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 7: TEXT INPUT
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 8: CHIPS
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="Widget.FamilyAdmin.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/primary_50</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 9: DIALOGS
         ═══════════════════════════════════════════════════════════ -->
    <style name="ThemeOverlay.FamilyAdmin.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FamilyAdmin.Dialog</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="ShapeAppearance.FamilyAdmin.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="FamilyAdmin.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 10: BOTTOM SHEET
         ═══════════════════════════════════════════════════════════ -->
    <style name="ThemeOverlay.FamilyAdmin.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.FamilyAdmin.BottomSheet</item>
        <item name="colorPrimary">@color/primary</item>
    </style>

    <style name="Widget.FamilyAdmin.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FamilyAdmin.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.FamilyAdmin.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 11: TEXT APPEARANCES
         ═══════════════════════════════════════════════════════════ -->

    <!-- Headlines -->
    <style name="TextAppearance.FamilyAdmin.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FamilyAdmin.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FamilyAdmin.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Titles -->
    <style name="TextAppearance.FamilyAdmin.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FamilyAdmin.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Body -->
    <style name="TextAppearance.FamilyAdmin.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.FamilyAdmin.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Caption -->
    <style name="TextAppearance.FamilyAdmin.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 12: ANIMATIONS
         ═══════════════════════════════════════════════════════════ -->
    <style name="Animation.FamilyAdmin.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Animation.FamilyAdmin.Fade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 13: PROGRESS
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.ProgressBar" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="trackColor">@color/grey_200</item>
        <item name="indicatorColor">@color/primary</item>
        <item name="trackThickness">4dp</item>
    </style>

    <style name="Widget.FamilyAdmin.CircularProgress" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/grey_200</item>
        <item name="trackThickness">4dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 14: BOTTOM NAVIGATION
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemRippleColor">@color/ripple_light</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 15: LIST ITEMS
         ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.FamilyAdmin.ListItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

</resources>
